{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AribaWritebackPayload",
  "description": "Structured result re-injected into SAP Ariba custom questionnaire fields (fields to be created by FORVIA IT, Q35). One object per analysed certificate.",
  "type": "object",
  "required": ["supplierAribaId", "certificateId", "analysisDate", "decision", "accuracyScore", "validTo", "dashboardUrl"],
  "properties": {
    "supplierAribaId": { "type": "string" },
    "aribaDocumentId": { "type": ["string", "null"], "description": "Attachment id from the Ariba data API" },
    "certificateId": { "type": "string" },
    "analysisDate": { "type": "string", "format": "date-time" },
    "referenceDate": { "type": "string", "format": "date" },
    "profileVersion": { "type": "string" },
    "decision": { "enum": ["GO", "REQUEST_CHANGES", "NO_GO"] },
    "noGoSubtype": { "enum": ["FORMAL_DEFECT", "STRUCTURAL", null] },
    "needsHumanReview": { "type": "boolean" },
    "riskScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "accuracyScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "insurerName": { "type": ["string", "null"] },
    "insurerRating": { "type": ["string", "null"] },
    "policyNumber": { "type": ["string", "null"] },
    "validFrom": { "type": ["string", "null"], "format": "date" },
    "validTo": { "type": ["string", "null"], "format": "date" },
    "daysToExpiry": { "type": ["integer", "null"] },
    "productLiabilityEur": { "type": ["integer", "null"] },
    "productRecallEur": { "type": ["integer", "null"] },
    "pureFinancialLossEur": { "type": ["integer", "null"] },
    "productLiabilityStatus": { "$ref": "#/$defs/status" },
    "productRecallStatus": { "$ref": "#/$defs/status" },
    "pureFinancialLossStatus": { "$ref": "#/$defs/status" },
    "topFinding": { "type": "string", "maxLength": 200 },
    "findingsCount": { "type": "integer" },
    "dashboardUrl": { "type": "string", "format": "uri" }
  },
  "$defs": { "status": { "enum": ["COMPLIANT", "BELOW_MINIMUM", "MISSING", "COVERED_NO_AMOUNT", "EXCLUDED", "UNCLEAR"] } }
}
