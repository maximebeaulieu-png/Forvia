# AlphaEdge — French-hosted OCR REST API (copy to .env.local, never commit secrets)
# Docs reality (20/08/2026): AlphaEdge = OCR + audio transcription; no chat LLM.
ALPHAEDGE_BASE_URL=https://api-endpoints.alphaedge-ai.com
ALPHAEDGE_API_KEY=
ALPHAEDGE_OCR_MODEL=alpha-digit-max   # alpha-digit-medium truncates silently — never primary

# Reasoning LLM (classify/extract/explain) — provider decided at the pipeline sprint.
# Candidate: Claude/Anthropic (not FR-hosted — §4.4 caveat to state in the offer).
# ANTHROPIC_API_KEY=

