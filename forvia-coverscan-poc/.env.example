# LLM — AlphaEdge French-hosted endpoint (credentials given in Claude Code; copy to .env.local, never commit)
LLM_PROVIDER=alphaedge
ALPHAEDGE_BASE_URL=
ALPHAEDGE_API_KEY=
ALPHAEDGE_MODEL=
ALPHAEDGE_VISION_MODEL=
LLM_MODE=vision            # vision | text-first  (set from `pnpm llm:probe`)

# Local dev fallback only
ANTHROPIC_API_KEY=

# App
DEMO_MODE=cached           # cached | live
DEMO_CLOCK=2025-04-15
DATABASE_URL=postgres://coverscan:coverscan@localhost:5432/coverscan
FX_SOURCE=cache            # ecb | cache
STORAGE_DIR=./storage
