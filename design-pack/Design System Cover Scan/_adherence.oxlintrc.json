      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:ink|go|amber|red|review)$/]",
        "message": "<KpiCard> deltaTone must be one of 'ink' | 'go' | 'amber' | 'red' | 'review'."
