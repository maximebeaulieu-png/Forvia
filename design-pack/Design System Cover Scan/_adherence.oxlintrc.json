        "message": "<Progress> doesn't accept that prop. Declared props: value, max, tone, height, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|primary|go|amber|red)$/]",
        "message": "<Progress> tone must be one of 'ink' | 'primary' | 'go' | 'amber' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestEmailSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|email|onChange|onCopy|onDownload|supplier|style|key|ref|className|style|children)$/]",
        "message": "<RequestEmailSheet> doesn't accept that prop. Declared props: open, onClose, email, onChange, onCopy, onDownload, supplier, style."
