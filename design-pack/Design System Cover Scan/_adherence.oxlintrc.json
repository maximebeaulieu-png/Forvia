{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/base/**",
              "components/coverage/**",
              "components/document/**",
              "components/verdict/**",
              "ui_kits/coverscan/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|leading|trailing|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: id, title, leading, trailing, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|size|icon|mono|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, size, icon, mono, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|go|amber|red|review|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'go' | 'amber' | 'red' | 'review' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|iconRight|onClick|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, iconRight, onClick, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|actions|padded|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, subtitle, actions, padded, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|showValue|page|quote|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceDot> doesn't accept that prop. Declared props: value, size, showValue, page, quote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|guarantee|required|foundOriginal|foundEur|basis|deductible|territory|territoryExcluded|status|confidence|page|quote|fxNote|group|key|ref|className|style|children)$/]",
        "message": "<CoverageRow> doesn't accept that prop. Declared props: id, guarantee, required, foundOriginal, foundEur, basis, deductible, territory, territoryExcluded, status, confidence, page, quote, fxNote, group."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:COMPLIANT|BELOW_MINIMUM|MISSING|COVERED_NO_AMOUNT|EXCLUDED|UNCLEAR|PRESENT)$/]",
        "message": "<CoverageRow> status must be one of 'COMPLIANT' | 'BELOW_MINIMUM' | 'MISSING' | 'COVERED_NO_AMOUNT' | 'EXCLUDED' | 'UNCLEAR' | 'PRESENT'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageRow'] > JSXAttribute[name.name='group'] > Literal[value!=/^(?:critical|secondary|other)$/]",
        "message": "<CoverageRow> group must be one of 'critical' | 'secondary' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|render|align|mono|muted|wrap|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, render, align, mono, muted, wrap, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:decision|size|label|style|key|ref|className|style|children)$/]",
        "message": "<DecisionChip> doesn't accept that prop. Declared props: decision, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionChip'] > JSXAttribute[name.name='decision'] > Literal[value!=/^(?:GO|REQUEST_CHANGES|FORMAL_DEFECT|STRUCTURAL|NEEDS_REVIEW|PROCESSING|PENDING)$/]",
        "message": "<DecisionChip> decision must be one of 'GO' | 'REQUEST_CHANGES' | 'FORMAL_DEFECT' | 'STRUCTURAL' | 'NEEDS_REVIEW' | 'PROCESSING' | 'PENDING'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<DecisionChip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|imageUrl|lang|ocrUsed|key|ref|className|style|children)$/]",
        "message": "<DocumentPage> doesn't accept that prop. Declared props: n, imageUrl, lang, ocrUsed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Finding'] > JSXAttribute > JSXIdentifier[name!=/^(?:ruleId|severity|title|quote|page|lang|fix|key|ref|className|style|children)$/]",
        "message": "<Finding> doesn't accept that prop. Declared props: ruleId, severity, title, quote, page, lang, fix."
      },
      {
        "selector": "JSXOpeningElement[name.name='Finding'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:BLOCK|CRITICAL|WARNING|INFO)$/]",
        "message": "<Finding> severity must be one of 'BLOCK' | 'CRITICAL' | 'WARNING' | 'INFO'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:found|required|status|width|height|showLabel|label|stacked|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GapBar> doesn't accept that prop. Declared props: found, required, status, width, height, showLabel, label, stacked, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapBar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:COMPLIANT|BELOW_MINIMUM|MISSING|COVERED_NO_AMOUNT|EXCLUDED|UNCLEAR)$/]",
        "message": "<GapBar> status must be one of 'COMPLIANT' | 'BELOW_MINIMUM' | 'MISSING' | 'COVERED_NO_AMOUNT' | 'EXCLUDED' | 'UNCLEAR'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|basePath|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, basePath, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|multiline|rows|mono|iconLeft|disabled|readOnly|size|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, multiline, rows, mono, iconLeft, disabled, readOnly, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Input> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|sub|tone|icon|delta|deltaTone|ring|onClick|style|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: label, value, unit, sub, tone, icon, delta, deltaTone, ring, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|go|amber|red|review)$/]",
        "message": "<KpiCard> tone must be one of 'ink' | 'go' | 'amber' | 'red' | 'review'."
